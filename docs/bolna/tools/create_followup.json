{
  "name": "create_followup",
  "description": "Use for an explicit human request, a non-emergency clinical concern, an unmatched patient, repeated recognition failure, or another unsupported request. This creates a callback only. Never claim that a live transfer is happening.",
  "pre_call_message": "One moment.",
  "parameters": {
    "type": "object",
    "required": ["category", "notes", "call_sid"],
    "properties": {
      "category": {
        "type": "string",
        "enum": ["human_requested", "clinical_concern", "other"],
        "description": "Use human_requested for a person, clinical_concern for a non-emergency medical question, and other for unmatched patients or unsupported requests."
      },
      "notes": { "type": "string" },
      "patient_id": { "type": "string" },
      "phone": { "type": "string" },
      "from_number": { "type": "string" },
      "call_sid": {
        "type": "string",
        "description": "Required for follow-up linkage; use {call_sid}."
      }
    }
  },
  "key": "custom_task",
  "value": {
    "method": "POST",
    "url": "{{BACKEND_BASE_URL}}/webhooks/bolna/tools/create_followup",
    "api_token": "Bearer {{BOLNA_API_TOKEN}}",
    "headers": {
      "Content-Type": "application/json"
    },
    "param": {
      "category": "%(category)s",
      "notes": "%(notes)s",
      "patient_id": "%(patient_id)s",
      "phone": "%(phone)s",
      "from_number": "%(from_number)s",
      "call_sid": "%(call_sid)s"
    }
  }
}
